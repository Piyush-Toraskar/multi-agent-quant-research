# Default: all local, synthetic market data, zero LLM calls.
AGENT_MODE=demo
# auto uses LangGraph if installed; otherwise it transparently LABELS the native engine.
WORKFLOW_ENGINE=auto
# Actual JSON-RPC MCP subprocess tool calls are the default, not in-process wrappers.
TOOL_TRANSPORT=mcp
# builtin: bundled MCP 2025-06-18 stdio tools subset; sdk: official mcp 1.x adapter.
MCP_IMPLEMENTATION=builtin

# For genuine model-driven tool calling, set AGENT_MODE=llm and supply a
# Chat Completions-compatible endpoint/model that supports function tools.
# Responses-only models are not supported by this adapter.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# OPENAI_API_KEY is an alternative to LLM_API_KEY.
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=90
MAX_AGENT_TURNS=4
MAX_REVISIONS=1
TOOL_TIMEOUT_SECONDS=90
MAX_WORKERS=2
MAX_PENDING_RUNS=8

# Optional cost estimate. Set BOTH from your own provider's actual tariff.
# LLM_INPUT_USD_PER_MILLION=0.0
# LLM_OUTPUT_USD_PER_MILLION=0.0

# Defaults to data/runtime/research.db, created automatically.
# DATA_DIR=C:/Users/Piyush/quant-data
# DATABASE_URL=postgresql+psycopg2://quant:CHANGE_ME@127.0.0.1:5432/quant
